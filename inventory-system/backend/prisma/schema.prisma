generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
}

enum PartCondition {
  SEM_DANO
  COM_DANO
}

enum PartSide {
  DIANTEIRO
  TRASEIRO
  LATERAL
  ESQUERDO
  DIREITO
  INTERNO
  EXTERNO
  SUPERIOR
  INFERIOR
  CENTRAL
  NAO_SE_APLICA
}

enum MovementType {
  ENTRADA
  RETIRADA
}

model UserPermission {
  id                    String  @id @default(uuid())
  userId                String  @unique
  user                  User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  canCreateParts        Boolean @default(false)
  canEditParts          Boolean @default(false)
  canArchiveParts       Boolean @default(false)
  canStockIn            Boolean @default(false)
  canStockOut           Boolean @default(false)
  canManageUsers        Boolean @default(false)
  canManageProducts     Boolean @default(false)
  canStockInProducts    Boolean @default(false)
  canStockOutProducts   Boolean @default(false)
  canDeleteProductMoves Boolean @default(false)

  @@map("user_permissions")
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         Role     @default(USER)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  permission        UserPermission?
  partsCreated      Part[]              @relation("PartCreatedBy")
  movementsRecorded InventoryMovement[] @relation("MovementUser")
  productsCreated   Product[]           @relation("ProductCreatedBy")
  productMovements  ProductMovement[]   @relation("ProductMovementUser")
  auditLogs         AuditLog[]
  refreshTokens     RefreshToken[]

  @@index([email])
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("refresh_tokens")
}

model Manufacturer {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  parts Part[]

  @@index([name])
  @@map("manufacturers")
}

model Part {
  id             String        @id @default(uuid())
  photoUrl       String?       @map("photo_url")
  damagePhotoUrl String?       @map("damage_photo_url")
  name           String
  sku            String?       @unique
  manufacturerId String        @map("manufacturer_id")
  manufacturer   Manufacturer  @relation(fields: [manufacturerId], references: [id], onDelete: Restrict)
  side           PartSide?     @map("side")
  condition      PartCondition @default(SEM_DANO)
  damageNotes    String?       @map("damage_notes")
  quantity       Int           @default(0)
  inventoryDate  DateTime      @map("inventory_date") @db.Date
  createdById    String        @map("created_by")
  createdBy      User          @relation("PartCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  archivedAt     DateTime?     @map("archived_at")

  movements InventoryMovement[]

  @@index([sku])
  @@index([name])
  @@index([manufacturerId])
  @@index([condition])
  @@index([archivedAt])
  @@map("parts")
}

model InventoryMovement {
  id             String       @id @default(uuid())
  partId         String       @map("part_id")
  part           Part         @relation(fields: [partId], references: [id], onDelete: Cascade)
  type           MovementType
  quantity       Int
  quantityBefore Int          @map("quantity_before")
  quantityAfter  Int          @map("quantity_after")
  userId         String       @map("user_id")
  user           User         @relation("MovementUser", fields: [userId], references: [id], onDelete: Restrict)
  description    String?
  createdAt      DateTime     @default(now()) @map("created_at")

  @@index([partId])
  @@index([userId])
  @@index([createdAt])
  @@map("inventory_movements")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id")
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?  @map("entity_id")
  before    Json?
  after     Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ===================== MODULO DE PRODUTOS (FIFO) =====================

model Product {
  id           String    @id @default(uuid())
  name         String
  manufacturer String
  quantity     Int       @default(0)
  createdById  String    @map("created_by")
  createdBy    User      @relation("ProductCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  archivedAt   DateTime? @map("archived_at")

  batches   ProductBatch[]
  movements ProductMovement[]

  @@index([name])
  @@index([manufacturer])
  @@map("products")
}

model ProductBatch {
  id                String          @id @default(uuid())
  productId         String          @map("product_id")
  product           Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  movementId        String          @unique @map("movement_id")
  movement          ProductMovement @relation("BatchOrigin", fields: [movementId], references: [id], onDelete: Cascade)
  quantityOriginal  Int             @map("quantity_original")
  quantityRemaining Int             @map("quantity_remaining")
  unitCostCents     Int             @map("unit_cost_cents")
  createdAt         DateTime        @default(now()) @map("created_at")

  consumptions ProductBatchConsumption[]

  @@index([productId])
  @@index([createdAt])
  @@map("product_batches")
}

model ProductMovement {
  id            String       @id @default(uuid())
  productId     String       @map("product_id")
  product       Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  type          MovementType
  quantity      Int
  unitCostCents Int?         @map("unit_cost_cents")
  totalCents    Int          @map("total_cents")
  setor         String?
  funcionario   String?
  description   String?
  userId        String       @map("user_id")
  user          User         @relation("ProductMovementUser", fields: [userId], references: [id], onDelete: Restrict)
  createdAt     DateTime     @default(now()) @map("created_at")

  originBatch  ProductBatch?             @relation("BatchOrigin")
  consumptions ProductBatchConsumption[] @relation("MovementConsumption")

  @@index([productId])
  @@index([userId])
  @@index([createdAt])
  @@index([setor])
  @@index([funcionario])
  @@map("product_movements")
}

model ProductBatchConsumption {
  id               String          @id @default(uuid())
  movementId       String          @map("movement_id")
  movement         ProductMovement @relation("MovementConsumption", fields: [movementId], references: [id], onDelete: Cascade)
  batchId          String          @map("batch_id")
  batch            ProductBatch    @relation(fields: [batchId], references: [id], onDelete: Cascade)
  quantityConsumed Int             @map("quantity_consumed")
  unitCostCents    Int             @map("unit_cost_cents")

  @@index([movementId])
  @@index([batchId])
  @@map("product_batch_consumptions")
}

// Listas usadas na retirada de produtos (gerenciadas pelo ADMIN).
model ProductSector {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  @@map("product_sectors")
}

model ProductEmployee {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  @@map("product_employees")
}
